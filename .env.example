# SQLite for local development. To move to PostgreSQL see README -> "Moving to PostgreSQL".
DATABASE_URL="file:./dev.db"
# Change this in any real deployment.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Demo mode (one-click sign-in) is ON unless this is "false". Set "false" + a real AUTH_SECRET for production.
DEMO_MODE="true"
